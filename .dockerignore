# ── Book-Tale — .dockerignore ──────────────────────────────────────────

# VCS metadata
.git
.gitignore
.gitattributes

# Python caches / artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data (lives on named volumes)
data/
logs/
backups/
uploads/
*.db
*.sqlite
*.sqlite3

# IDE / editor config
.vscode/
.idea/
*.swp
*.swo

# CI / agent config
.github/
.gemini/
PROJECT_ANALYSIS.md

# Node (frontend build happens inside the image)
node_modules/
npm-debug.log*
