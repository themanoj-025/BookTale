radar_balance.txt

# ── Portfolio-standard ignores (sweep 2026-09) ──────────────
*.db
*.db-shm
*.db-wal
.coverage.*
coverage.xml

# ML artifacts (scripts + dataset + images) - gitignored, see MODERNIZATION_AUDIT.md
app/services/recommendations/ml/

# ── docs/ (repository documentation) ────────────────────────────────
