# ==============================================================================
# Book-Tale - Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS & ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.test
.env.staging
.env.production
!.env.example
!.env.template
!.env.sample

# Private keys, certificates & credentials
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.cer
*.crt
*.der
*.id_rsa
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Cloud & service credentials
credentials.json
client_secret*.json
service-account*.json
service_account*.json
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist
.aws/
.azure/
.gcp/
gcloud/
.act-secrets
*.publishsettings

# Authentication tokens & configs
.netrc
.pypirc
.npmrc
*token*.json
token.pickle
auth*.json

# ------------------------------------------------------------------------------
# 2. PYTHON RUNTIME, BUILDS & VIRTUAL ENVIRONMENTS
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
.eggs/
*.egg-info/
dist/
build/

# Static dist is committed so a fresh clone serves hashed URLs without running npm first:
!app/static/dist/

# Virtual environments
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. TESTING & CODE QUALITY
# ------------------------------------------------------------------------------
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
radar_balance.txt

# ------------------------------------------------------------------------------
# 4. LOGS, DATA & DATABASE STORAGE
# ------------------------------------------------------------------------------
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.dump
*.stackdump

# Project runtime data
data/
backups/
data/generated/

# ML artifacts (scripts + dataset + images) - gitignored, see MODERNIZATION_AUDIT.md
app/services/recommendations/ml/

# ------------------------------------------------------------------------------
# 5. FRONTEND & NODE
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. IDE & EDITORS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.local.*
.vscode/mcp.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/
*.bak.gemini/

# ------------------------------------------------------------------------------
# 7. OS FILES & TEMPORARIES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# ==============================================================================
# KEEP: AI provenance & transparency files — must remain visible
# ==============================================================================
!AI_DISCLOSURE.md
!AI_USAGE.md
!PROMPTS.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.cursorrules
!.github/copilot-instructions.md
!.claude/commands/
!.claude/commands/**
!.claude/agents/
!.claude/agents/**
!.claude/settings.json
!docs/ai/
!docs/ai/**
!.ai/
!.ai/**
!ai-provenance.json
!.gitmessage
!CITATION.cff
